# MongoDB Atlas connection string (see README for how to get this — it's free)
#MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/traject

# A long random secret used to sign login tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string

# Port the backend server runs on
PORT=5000

# The URL your frontend runs on, for CORS (Vite's default dev port shown below)
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key — get yours free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
