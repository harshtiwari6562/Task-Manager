# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed origins for CORS (comma-separated, required in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret used to sign login JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=replace_this_with_a_long_random_string_of_32_characters_minimum

# MySQL Database Configuration
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=traject

# AI Configuration (Gemini & Groq fallback)
# Get Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-2.0-flash
GROQ_API_KEY=
AI_GLOBAL_DAILY_LIMIT=1000
